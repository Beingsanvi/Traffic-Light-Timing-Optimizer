# Atlas: use a database user's connection URI (not an Atlas management API key).
MONGO_DB_URL=mongodb://127.0.0.1:27017/smartflow
MONGO_DB_NAME=smartflow
PORT=3000
NODE_ENV=development
# Set to the exact number of trusted reverse-proxy hops in production (usually 1).
TRUST_PROXY=0
SIMULATION_ENABLED=true
